{
  "name": "placex-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "spacetime build --module-path .",
    "publish:local": "spacetime publish placex-local --server local --module-path . --yes",
    "publish:cloud": "spacetime publish placex --server maincloud --module-path . --yes",
    "generate": "spacetime generate --lang typescript --out-dir ../client/src/bindings --module-path . --yes",
    "test": "vitest run"
  },
  "dependencies": {
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
